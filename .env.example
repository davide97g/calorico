# --- Postgres ---
POSTGRES_USER=calorico
POSTGRES_PASSWORD=change-me
POSTGRES_DB=calorico

# --- API ---
# Local dev (Postgres from docker-compose.dev.yml):
DATABASE_URL=postgres://calorico:calorico@localhost:5432/calorico
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173
# Open Food Facts asks for a descriptive User-Agent with a contact address.
OFF_USER_AGENT=Calorico/0.1 (personal project; contact: you@example.com)
OFF_ENABLED=true

# --- Photo upload: Cloudflare R2 (optional) ---
# All five together, or photo upload stays switched off. Create an R2 bucket and
# an API token scoped to it ("Object Read & Write").
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=calorico
# Public base URL of the bucket: the r2.dev domain or your own custom domain.
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
# Backstop only — the browser compresses to a few hundred KB before uploading.
R2_MAX_UPLOAD_BYTES=3145728

# --- Web (production, Dokploy) ---
# Leave empty to keep the browser same-origin and let nginx proxy /api.
VITE_API_URL=

# --- Dokploy (local only; never set these on the server) ---
# The API key that manages the deployment. Kept out of git by .gitignore.
DOKPLOY_URL=https://dokploy.davideghiotto.it
DOKPLOY_API_KEY=
DOKPLOY_PROJECT_ID=
DOKPLOY_COMPOSE_ID=
