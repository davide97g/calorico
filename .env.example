# --- Postgres ---
POSTGRES_USER=calorico
POSTGRES_PASSWORD=change-me
POSTGRES_DB=calorico

# --- API ---
# Local dev (Postgres from docker-compose.dev.yml):
DATABASE_URL=postgres://calorico:calorico@localhost:5432/calorico
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173
# Open Food Facts asks for a descriptive User-Agent with a contact address.
OFF_USER_AGENT=Calorico/0.1 (personal project; contact: you@example.com)
OFF_ENABLED=true

# --- Error tracking: Sentry (optional) ---
# Unset: never initialised, nothing leaves the box. VITE_SENTRY_DSN is a separate
# browser DSN and is baked into the bundle at build time, so it is public.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# 0 disables performance tracing; 0.1 samples a tenth of requests.
SENTRY_TRACES_SAMPLE_RATE=0
VITE_SENTRY_DSN=

# --- Premium (fake paywall) ---
# Meal photos a free account may analyse per rolling 24 hours. Premium accounts
# are uncapped; there is no payment provider yet — see routes/premium.ts.
FREE_DAILY_PHOTO_SCANS=3

# --- Riconoscimento foto (opzionale) ---
# Provider, chiave e modello vanno insieme: se ne manca uno la funzione si
# spegne da sola e il pulsante non compare.
# Nessun modello di default: i nomi cambiano troppo spesso per fissarli qui.
#   openai   -> es. gpt-5-mini, gpt-4.1-mini
#   mistral  -> https://docs.mistral.ai/getting-started/models/
VISION_PROVIDER=          # openai | mistral | stub
VISION_API_KEY=
VISION_MODEL=
# Solo per openai: qualunque host compatibile (Groq, OpenRouter, Ollama locale).
# Vuoto = OpenAI.
VISION_BASE_URL=
# Solo come rete di sicurezza: il browser comprime a ~500 KB prima di inviare.
VISION_MAX_IMAGE_BYTES=1048576
VISION_TIMEOUT_MS=30000

# --- Promemoria push (opzionale) ---
# Le due chiavi e il contatto vanno insieme: se ne manca uno lo scheduler non
# parte e l'app dice che le notifiche non sono disponibili.
# Genera la coppia con:  npm run vapid
# Attenzione: cambiare le chiavi invalida le iscrizioni già create sui telefoni.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Quanti promemoria può tenere un account.
MAX_REMINDERS_PER_USER=12
# Quanto tardi può ancora partire un promemoria (riavvii, deploy, clock drift).
REMINDER_GRACE_MINUTES=10

# --- Web (production, Dokploy) ---
# Leave empty to keep the browser same-origin and let nginx proxy /api.
VITE_API_URL=

# --- Dokploy (local only; never set these on the server) ---
# The API key that manages the deployment. Kept out of git by .gitignore.
DOKPLOY_URL=https://dokploy.davideghiotto.it
DOKPLOY_API_KEY=
DOKPLOY_PROJECT_ID=
DOKPLOY_COMPOSE_ID=
