# --- Postgres ---
POSTGRES_USER=calorico
POSTGRES_PASSWORD=change-me
POSTGRES_DB=calorico

# --- API ---
# Local dev (Postgres from docker-compose.dev.yml):
DATABASE_URL=postgres://calorico:calorico@localhost:5432/calorico
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173
# Open Food Facts asks for a descriptive User-Agent with a contact address.
OFF_USER_AGENT=Calorico/0.1 (personal project; contact: you@example.com)
OFF_ENABLED=true

# --- Error tracking: Sentry (optional) ---
# Unset: never initialised, nothing leaves the box. VITE_SENTRY_DSN is a separate
# browser DSN and is baked into the bundle at build time, so it is public.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# 0 disables performance tracing; 0.1 samples a tenth of requests.
SENTRY_TRACES_SAMPLE_RATE=0
VITE_SENTRY_DSN=

# --- Premium (Stripe) ---
# Meal photos a free account may analyse, for the life of the account. One
# taste, then the paywall. Premium accounts are uncapped.
FREE_PHOTO_SCANS=1
# Le tre variabili vanno insieme: se ne manca una il checkout risponde 503 e
# l'app nasconde il pulsante. Il webhook è l'unica cosa che attiva Premium, e
# senza il suo segreto non può distinguere Stripe da chiunque altro.
#   sandbox: sk_test_...  |  live: sk_live_...
STRIPE_SECRET_KEY=
# Il prezzo ricorrente a cui ci si abbona (5 €/mese), price_...
STRIPE_PRICE_ID=
# Dato da `stripe listen` in locale, o dall'endpoint creato su Stripe in prod.
STRIPE_WEBHOOK_SECRET=
# URL pubblico del frontend: è lì che Stripe rimanda il browser dopo il
# pagamento (/premium/return). In locale è Vite, non l'API.
# Solo l'origine, senza percorso: l'applicazione è montata sulla radice del
# sito. In produzione: https://calorico.davideghiotto.it
APP_URL=http://localhost:5173

# --- Riconoscimento foto (opzionale) ---
# Provider, chiave e modello vanno insieme: se ne manca uno la funzione si
# spegne da sola e il pulsante non compare.
# Nessun modello di default: i nomi cambiano troppo spesso per fissarli qui.
#   openai   -> es. gpt-5-mini, gpt-4.1-mini
#   mistral  -> https://docs.mistral.ai/getting-started/models/
VISION_PROVIDER=          # openai | mistral | stub
VISION_API_KEY=
VISION_MODEL=
# Solo per openai: qualunque host compatibile (Groq, OpenRouter, Ollama locale).
# Vuoto = OpenAI.
VISION_BASE_URL=
# Solo come rete di sicurezza: il browser comprime a ~500 KB prima di inviare.
VISION_MAX_IMAGE_BYTES=1048576
VISION_TIMEOUT_MS=30000

# --- Promemoria push (opzionale) ---
# Le due chiavi e il contatto vanno insieme: se ne manca uno lo scheduler non
# parte e l'app dice che le notifiche non sono disponibili.
# Genera la coppia con:  npm run vapid
# Attenzione: cambiare le chiavi invalida le iscrizioni già create sui telefoni.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Quanti promemoria può tenere un account.
MAX_REMINDERS_PER_USER=12
# Quanti piatti salvati può tenere un account.
MAX_MEALS_PER_USER=40
# Quanto tardi può ancora partire un promemoria (riavvii, deploy, clock drift).
REMINDER_GRACE_MINUTES=10

# --- Notifica di nuova versione (opzionale) ---
# Dove l'API legge /version.json per capire quale build è pubblicata: se cambia,
# manda una notifica push ai dispositivi rimasti sulla versione vecchia. Toccarla
# ricarica la PWA sulla nuova build.
# In Docker Compose è il nome del servizio web sulla rete interna (http://web).
# Vuoto = funzione disattivata (in sviluppo vite non serve version.json).
WEB_ORIGIN=
# Quanto attende una build appena pubblicata prima di annunciarsi: il tempo che
# serve alle app aperte per aggiornarsi da sole ed uscire dalla lista.
RELEASE_NOTICE_DELAY_MINUTES=10

# --- Web (production, Dokploy) ---
# Leave empty to keep the browser same-origin and let nginx proxy /api.
VITE_API_URL=

# --- Dokploy (local only; never set these on the server) ---
# The API key that manages the deployment. Kept out of git by .gitignore.
DOKPLOY_URL=https://dokploy.davideghiotto.it
DOKPLOY_API_KEY=
DOKPLOY_PROJECT_ID=
DOKPLOY_COMPOSE_ID=
